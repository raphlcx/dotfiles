#!/usr/bin/env zsh

# Commands
_log() {
  echo "$1"
}

_link() {
  ln -sfn "$1" "$2"
}

# Start setup
_log 'Setting up dotfiles ...'

# Navigate into the directory containing files to setup
pushd home >/dev/null || exit

while read -r f
do
  # Omit the preceding ./ in file path
  f=$(echo "$f" | cut -d '/' -f2-)

  # The absolute file path
  fp=$(readlink -f "$f")

  _log "linking $HOME/$f -> $fp"

  mkdir -p  "$(dirname "$HOME/$f")"

  _link "$fp" "$HOME/$f"

done < <(find . -type f)

# Restore original working directory
popd >/dev/null || exit

_log 'Done.'
